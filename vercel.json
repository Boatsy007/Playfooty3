{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/backend/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npm ci && npm --prefix backend ci && PLAYWRIGHT_BROWSERS_PATH=0 PLAYWRIGHT_SKIP_BROWSER_GC=1 npm --prefix backend run playhq:install-browser && npm --prefix backend run playhq:prepare-vercel-browser",
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "0",
    "PLAYWRIGHT_SKIP_BROWSER_GC": "1"
  },
  "functions": {
    "backend/api/index.ts": {
      "includeFiles": "backend/api/.playwright/**"
    }
  }
}
