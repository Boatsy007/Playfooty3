// CNCA Rankings Engine — Prisma Schema
// Target: Supabase (PostgreSQL)
// Run: npx prisma migrate dev --name init
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")   // Supabase requires a direct connection for migrations
}

// ─── Reference / lookup tables ───────────────────────────────────────────────

model State {
  id        String   @id @default(uuid())
  code      String   @unique  // NSW, VIC, QLD, etc.
  name      String
  leagues   League[]
  clubs     Club[]
  createdAt DateTime @default(now())

  @@map("states")
}

model Association {
  id           String   @id @default(uuid())
  name         String
  shortName    String?
  stateId      String?
  websiteUrl   String?
  contactEmail String?
  leagues      League[]

  // PlayHQ discovery metadata (automated crawl of the association directory)
  playhqOrgSlug    String?   @unique
  playhqUrl        String?
  logoUrl          String?
  stateCode        String?   // "VIC" | "NSW" … as shown in the directory
  active           Boolean   @default(true)
  lastDiscoveredAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("associations")
}

// ─── League / competition ─────────────────────────────────────────────────────

model League {
  id            String           @id @default(uuid())
  name          String
  shortName     String?
  stateId       String
  associationId String?
  isActive      Boolean          @default(true)

  // League strength (0–100 score the ranking engine consumes). Now DERIVED
  // from finalStrengthRating × 20 — kept so the ranking formula is untouched.
  strengthScore Float            @default(50)  // 0–100  (= finalStrengthRating × 20)
  strengthTier  Int              @default(3)   // 1–5    (= round(finalStrengthRating))
  strengthNotes String?

  // Automatic strength model (0–5). Ranking uses finalStrengthRating via
  // strengthScore. Manual override is optional and wins when set.
  automaticStrengthRating Float   @default(3.0)   // computed from ladder data
  manualStrengthOverride  Float?                  // 0–5, null = no override
  finalStrengthRating     Float   @default(3.0)   // = manualOverride ?? automatic
  strengthConfidence      Float   @default(0.3)   // 0–1

  // Phase 6: explainability — why the league holds its rating, and when it was
  // last computed. Written by every national recalculation.
  strengthReasoning    String?
  strengthCalculatedAt DateTime?

  // PlayHQ discovery metadata (automated). Does NOT affect the ranking formula.
  playhqOrgSlug       String?
  playhqGradeId       String?
  playhqGradeName     String?
  ladderUrl           String?
  currentSeason       String?
  enabled             Boolean   @default(true)   // admin can disable a league
  autoDiscovered      Boolean   @default(false)  // created by the crawler
  needsStrengthReview Boolean   @default(false)  // true until admin sets strength
  gradeOverride       String?   // admin can force a specific grade
  ladderUrlOverride   String?   // admin can pin the ladder URL
  lastSyncedAt        DateTime?
  syncError           String?

  // ── Phase 2: multi-source provenance + admin/status ──────────────────────
  primarySource      String?   // PLAYHQ | NETBALL_CONNECT | COUNTRY_FOOTY | MANUAL_IMAGE | MANUAL | CSV
  importType         String?   @default("AUTO")     // AUTO | MANUAL | IMAGE
  sourceUrl          String?
  status             String    @default("ACTIVE")   // ACTIVE | DISABLED | NEEDS_REVIEW
  lastSuccessAt      DateTime?                        // last successful scrape
  lastManualUpdateAt DateTime?                        // last operator edit
  dataConfidence     Float     @default(0.5)         // 0–1 confidence in the data
  failureCount       Int       @default(0)
  retryCount         Int       @default(0)
  manualOverride     Boolean   @default(false)       // protect from auto imports
  hidden             Boolean   @default(false)       // hide from public site
  regionName         String?                          // country region label
  websiteUrl         String?
  facebookUrl        String?
  logoUrl            String?

  // ── PlayFooty football data-source control centre ────────────────────────
  // Additive fields only: existing netball/ranking systems continue to use the
  // legacy provenance fields above until they are migrated deliberately.
  sport                    String   @default("NETBALL") // NETBALL | FOOTBALL
  primaryDataSource        String?  // PLAYHQ_API | PLAYHQ_SCRAPER | CSV_UPLOAD | OCR_UPLOAD | MANUAL_ENTRY
  fallbackDataSources      String?  // JSON string array of the same source constants
  playhqOrganisationId     String?
  playhqCompetitionId      String?
  playhqSeasonId           String?
  scrapeEnabled            Boolean  @default(false)
  apiEnabled               Boolean  @default(false)
  manualEntryEnabled       Boolean  @default(false)
  lastSyncAt               DateTime?
  lastSuccessfulSyncAt     DateTime?
  syncStatus               String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | READY | RUNNING | SUCCESS | FAILED | NEEDS_REVIEW
  dataSourceSyncError      String?

  // ── Never-destroy: soft-delete / archive / approval ──────────────────────
  archivedAt     DateTime?                            // soft-deleted / archived
  approvalStatus String    @default("APPROVED")       // PENDING | APPROVED | REJECTED
  leagueType     String?                              // FNL | FANL | STANDALONE_NA | OTHER
  reviewReason   String?

  // Averages (recalculated each cycle)
  avgGoalsPerGame  Float?
  avgMarginPerGame Float?

  // Data sources for automated collection
  sources      LeagueSource[]

  // Relationships
  state        State            @relation(fields: [stateId], references: [id])
  association  Association?     @relation(fields: [associationId], references: [id])
  clubSeasons  ClubLeagueSeason[]
  matches      Match[]
  rankingEntries RankingEntry[]
  footballFixtures FootballFixture[]
  footballResults  FootballResult[]
  footballLadderEntries FootballLadderEntry[]
  footballImports FootballDataImport[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("leagues")
}

// ─── PlayFooty football data-source control centre ───────────────────────────

model FootballDataImport {
  id              String   @id @default(uuid())
  leagueId        String
  sourceType      String   // PLAYHQ_API | PLAYHQ_SCRAPER | CSV_UPLOAD | OCR_UPLOAD | MANUAL_ENTRY
  dataType        String   // FIXTURES | RESULTS | LADDER | TEAMS | GRADES | ROUNDS
  sourceUrl       String?
  payloadHash     String
  dryRun          Boolean  @default(false)
  status          String   @default("PENDING") // PENDING | PREVIEWED | COMMITTED | CONFLICT | FAILED | PUBLISHED
  recordsFound    Int      @default(0)
  recordsImported Int      @default(0)
  conflictsFound  Int      @default(0)
  confidence      Float    @default(0.5)
  error           String?
  payload         String?
  scrapedAt       DateTime?
  createdBy       String   @default("admin")
  createdAt       DateTime @default(now())
  publishedAt     DateTime?

  league   League @relation(fields: [leagueId], references: [id])
  conflicts FootballDataConflict[]

  @@unique([leagueId, sourceType, dataType, payloadHash])
  @@index([leagueId, dataType, status])
  @@map("football_data_imports")
}

model FootballDataConflict {
  id        String   @id @default(uuid())
  importId  String
  leagueId  String
  entityType String  // FIXTURE | RESULT | LADDER
  entityKey  String
  existing   String?
  incoming   String
  status     String  @default("PENDING") // PENDING | APPROVED | REJECTED | MERGED
  reason     String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  import FootballDataImport @relation(fields: [importId], references: [id])

  @@index([leagueId, status])
  @@map("football_data_conflicts")
}

model FootballFixture {
  id          String   @id @default(uuid())
  leagueId    String
  season      String
  grade       String   @default("Senior Football")
  round       String?
  homeClubId  String?
  awayClubId  String?
  homeName    String
  awayName    String
  matchDate   DateTime?
  venue       String?
  sourceType  String
  sourceUrl   String?
  verified    Boolean  @default(false)
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, season, grade, round, homeName, awayName])
  @@index([leagueId, season, grade])
  @@map("football_fixtures")
}

model FootballResult {
  id           String   @id @default(uuid())
  leagueId     String
  season       String
  grade        String   @default("Senior Football")
  round        String?
  homeClubId   String?
  awayClubId   String?
  homeName     String
  awayName     String
  homeGoals    Int      @default(0)
  homeBehinds  Int      @default(0)
  homePoints   Int      @default(0)
  awayGoals    Int      @default(0)
  awayBehinds  Int      @default(0)
  awayPoints   Int      @default(0)
  matchDate    DateTime?
  venue        String?
  sourceType   String
  sourceUrl    String?
  verified     Boolean  @default(false)
  published    Boolean  @default(false)
  externalId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, season, grade, round, homeName, awayName])
  @@index([leagueId, season, grade, published])
  @@map("football_results")
}

model FootballLadderEntry {
  id              String   @id @default(uuid())
  leagueId        String
  season          String
  grade           String   @default("Senior Football")
  position        Int
  clubId          String?
  clubName        String
  played          Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  pointsFor       Int      @default(0)
  pointsAgainst   Int      @default(0)
  percentage      Float    @default(0)
  premiershipPoints Int    @default(0)
  sourceType      String
  verified        Boolean  @default(false)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, season, grade, clubName])
  @@index([leagueId, season, grade, published])
  @@map("football_ladder_entries")
}

// URL/endpoint for each data source per league
model LeagueSource {
  id            String    @id @default(uuid())
  leagueId      String
  sourceType    String    // PLAYHQ | NETBALL_CONNECT | CSV_IMPORT | MANUAL_ENTRY
  ladderUrl     String?
  fixturesUrl   String?
  resultsUrl    String?
  apiKey        String?   // encrypted in production via Supabase Vault
  season        String    // "2025"
  isActive      Boolean   @default(true)
  lastScrapedAt DateTime?
  lastStatus    String?   // SUCCESS | PARTIAL | FAILED | PENDING_REVIEW
  notes         String?

  league     League      @relation(fields: [leagueId], references: [id])
  scrapeLogs ScrapeLog[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("league_sources")
}

// ─── Club ─────────────────────────────────────────────────────────────────────

model Club {
  id              String           @id @default(uuid())
  name            String           // Canonical name
  slug            String           @unique  // "dubbo-netball-club"
  shortName       String?
  stateId         String
  region          String?
  latitude        Float?
  longitude       Float?

  // Brand
  logoUrl         String?
  primaryColour   String?
  secondaryColour String?
  websiteUrl      String?
  facebookUrl     String?
  instagramUrl    String?

  // CNCA status
  cncaQualified    Boolean @default(false)
  invitationStatus String? // null | INVITED | CONFIRMED | DECLINED | WAITLIST

  isActive Boolean @default(true)
  notes    String?

  // Phase 2: manual provenance
  manualOverride Boolean  @default(false)  // protect manual clubs from auto imports
  source         String?                    // origin of this club record
  bestRank       Int?                       // historical best national rank

  // Never-destroy: soft-delete / archive / approval
  archivedAt     DateTime?
  approvalStatus String   @default("APPROVED")  // PENDING | APPROVED | REJECTED
  townName       String?                          // real town this club belongs to

  // Relationships
  state          State            @relation(fields: [stateId], references: [id])
  nameVariants   ClubNameVariant[]
  leagueSeasons  ClubLeagueSeason[]
  homeMatches    Match[]          @relation("HomeClub")
  awayMatches    Match[]          @relation("AwayClub")
  rankingEntries RankingEntry[]
  snapshots      RankingSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clubs")
}

// Known name variants — used by club normaliser to deduplicate scraped data
model ClubNameVariant {
  id         String  @id @default(uuid())
  clubId     String
  rawName    String  // exactly as seen in source data
  sourceType String
  confidence Float   @default(1.0)  // 0–1; <0.8 flagged for human review

  club      Club     @relation(fields: [clubId], references: [id])
  createdAt DateTime @default(now())

  @@unique([rawName, sourceType])
  @@map("club_name_variants")
}

// A club's membership of a league in a specific season
model ClubLeagueSeason {
  id       String  @id @default(uuid())
  clubId   String
  leagueId String
  season   String
  grade    String  @default("A Grade")
  isActive Boolean @default(true)

  // Aggregated season stats (kept in sync by ranking engine)
  played       Int   @default(0)
  wins         Int   @default(0)
  losses       Int   @default(0)
  draws        Int   @default(0)
  goalsFor     Int   @default(0)
  goalsAgainst Int   @default(0)
  percentage   Float @default(0)
  points       Int   @default(0)

  // Advanced-ladder fields (from PlayHQ "Show advanced ladder")
  position          Int?
  byes              Int     @default(0)
  forfeits          Int     @default(0)
  disqualifications Int     @default(0)
  adjustments       Int     @default(0)
  playhqTeamUrl     String?
  playhqTeamId      String?

  // Finals
  finalsWins   Int     @default(0)
  finalsLosses Int     @default(0)
  isPremier    Boolean @default(false)

  club   Club   @relation(fields: [clubId], references: [id])
  league League @relation(fields: [leagueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, leagueId, season, grade])
  @@map("club_league_seasons")
}

// ─── Match ────────────────────────────────────────────────────────────────────

model Match {
  id         String    @id @default(uuid())
  leagueId   String
  homeClubId String
  awayClubId String
  season     String
  round      Int?
  matchDate  DateTime?
  venue      String?
  homeGoals  Int
  awayGoals  Int
  isFinal    Boolean   @default(false)
  finalRound String?   // "QF" | "SF" | "PF" | "GF"
  verified   Boolean   @default(false)

  // Source tracking
  sourceType String
  sourceUrl  String?
  scrapedAt  DateTime?

  league   League @relation(fields: [leagueId], references: [id])
  homeClub Club   @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club   @relation("AwayClub", fields: [awayClubId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

// ─── Ranking engine ───────────────────────────────────────────────────────────

// The weights config for a ranking calculation run.
// Stored so historical rankings can be reproduced exactly.
model RankingConfig {
  id       String  @id @default(uuid())
  label    String  @default("Default")
  isActive Boolean @default(true)

  // Stored as serialised JSON for flexibility
  weights  String  // JSON: { winPercentage: 0.25, ... }

  notes    String?
  runs     RankingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ranking_configs")
}

// One execution of the ranking engine (weekly or manual)
model RankingRun {
  id          String    @id @default(uuid())
  weekLabel   String    // ISO week: "2025-W27"
  season      String    // "2025"
  configId    String?
  status      String    // QUEUED | RUNNING | COMPLETED | FAILED
  clubCount   Int       @default(0)
  completedAt DateTime?
  errorLog    String?   // JSON array of error messages
  notes       String?

  config    RankingConfig?  @relation(fields: [configId], references: [id])
  entries   RankingEntry[]
  snapshots RankingSnapshot[]
  scrapeLogs ScrapeLog[]

  createdAt DateTime @default(now())

  @@index([season, weekLabel])
  @@map("ranking_runs")
}

// The ranking entries for a single run
model RankingEntry {
  id           String  @id @default(uuid())
  runId        String
  clubId       String
  clubName     String
  leagueId     String
  leagueName   String
  state        String

  rank         Int
  previousRank Int?
  rankMovement Int    @default(0)  // +ve = moved up

  powerRating     Float
  componentScores String  // JSON: { winPercentage: 82.3, ... }
  recentForm      String  // JSON: ["W","W","L","W","W"]
  calculatedAt    String

  rankingRun RankingRun @relation(fields: [runId], references: [id])
  club       Club       @relation(fields: [clubId], references: [id])
  league     League     @relation(fields: [leagueId], references: [id])

  createdAt DateTime @default(now())

  @@unique([runId, clubId])
  @@index([state, rank])
  @@index([clubId])
  @@map("ranking_entries")
}

// Immutable weekly snapshot — stored forever for historical graphs
model RankingSnapshot {
  id          String @id @default(uuid())
  runId       String
  clubId      String
  weekLabel   String
  season      String
  rank        Int
  powerRating Float
  movement    Int

  run  RankingRun @relation(fields: [runId], references: [id])
  club Club       @relation(fields: [clubId], references: [id])

  createdAt DateTime @default(now())

  @@unique([weekLabel, clubId])
  @@index([clubId, weekLabel])
  @@map("ranking_snapshots")
}

// ─── Scraping infrastructure ──────────────────────────────────────────────────

model ScrapeLog {
  id             String  @id @default(uuid())
  runId          String?
  leagueSourceId String?
  sourceType     String
  sourceUrl      String?
  status         String  // SUCCESS | PARTIAL | FAILED | PENDING_REVIEW
  recordsFound   Int     @default(0)
  recordsStored  Int     @default(0)
  durationMs     Int?
  errorMessage   String?
  retryCount     Int     @default(0)
  scrapedAt      DateTime @default(now())

  run          RankingRun?   @relation(fields: [runId], references: [id])
  leagueSource LeagueSource? @relation(fields: [leagueSourceId], references: [id])

  @@map("scrape_logs")
}

// Human-review queue for data that couldn't be automatically resolved
model ReviewQueue {
  id                String    @id @default(uuid())
  type              String    // CLUB_MATCH | MISSING_LEAGUE | NAME_CONFLICT | STAT_ANOMALY
  severity          String    @default("WARNING")  // INFO | WARNING | ERROR
  description       String
  rawData           String?   // JSON
  status            String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  resolvedCanonical String?
  resolvedBy        String?
  resolvedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())

  @@map("review_queue")
}

// ─── Admin / auth ─────────────────────────────────────────────────────────────

model AdminUser {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  role        String    @default("VIEWER")  // VIEWER | EDITOR | ADMIN | SUPERADMIN
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  auditLogs   AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // e.g. "UPDATE_LEAGUE_STRENGTH", "TRIGGER_RANKING_RUN"
  entityType String?  // e.g. "League", "Club"
  entityId   String?
  before     String?  // JSON
  after      String?  // JSON
  ipAddress  String?
  source     String?  // ADMIN | OCR | PLAYHQ | CSV | SYSTEM
  reason     String?  // optional human reason
  createdAt  DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// Nothing uncertain publishes automatically — it enters this queue.
model ReviewItem {
  id         String    @id @default(uuid())
  entityType String    // League | Club | Ladder | Ranking | Logo
  entityId   String?
  kind       String    // UNKNOWN_LEAGUE | DUPLICATE_CLUB | LOW_CONFIDENCE_OCR | NAME_CHANGE | LADDER_CHANGE | MISSING_LOGO | STRENGTH_UNCERTAIN
  reason     String
  confidence Float?     // 0–1 where applicable
  payload    String?    // JSON — the proposed change / context
  status     String    @default("PENDING")  // PENDING | APPROVED | REJECTED | MERGED | IGNORED
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([status])
  @@map("review_items")
}

// One-click backups / restore points (full JSON snapshot of core tables).
model Backup {
  id        String   @id @default(uuid())
  label     String
  kind      String   @default("MANUAL")  // MANUAL | NIGHTLY | PRE_RESTORE
  counts    String?  // JSON summary { leagues, clubs, ... }
  data      String   // JSON dump of core tables
  createdAt DateTime @default(now())

  @@map("backups")
}

// OCR image imports (Phase 3) — every ladder image ever uploaded is kept:
// original image, extraction, confidence, what was committed, when, by whom.
// Never deleted — discarded imports are status DISCARDED, not removed.
model OcrImport {
  id             String    @id @default(uuid())
  leagueId       String?
  leagueName     String?                       // resolved league at commit time
  image          String                        // original data-URL / base64 image
  detectedLeague String?                       // what the OCR read off the image
  detectedGrade  String?
  rowCount       Int       @default(0)
  uncertainCount Int       @default(0)         // rows without a confident club match
  confidence     Float?                        // mean club-match score (0–1)
  rows           String?                       // JSON: extracted + matched preview rows
  committedRows  String?                       // JSON: what the operator actually applied
  status         String    @default("PREVIEWED") // PREVIEWED | COMMITTED | DISCARDED
  notes          String?
  createdBy      String    @default("admin")
  createdAt      DateTime  @default(now())
  committedAt    DateTime?

  @@index([leagueId])
  @@index([createdAt])
  @@map("ocr_imports")
}

// AI Publishing: generated article drafts. Body is built from real ranking data
// (templated prose over actual numbers), reviewed in the admin portal, then
// published. Status flows DRAFT → APPROVED → PUBLISHED (never destroyed).
model GeneratedArticle {
  id          String    @id @default(uuid())
  slug        String    @unique
  kind        String                       // NATIONAL_ROUNDUP | BIGGEST_MOVERS | STRONGEST_LEAGUES | LEAGUE_ROUNDUP | CLUB_UPDATE
  category    String    @default("rankings")
  title       String
  subtitle    String?
  summary     String
  body        String                       // JSON: Block[] (p/h/quote), same shape as the news model
  heroSeed    String    @default("rankings")
  tags        String?                      // JSON: { state?, league?, leagueId?, club?, clubId? }
  status      String    @default("DRAFT")  // DRAFT | APPROVED | PUBLISHED | ARCHIVED
  runId       String?                      // ranking run this was generated from
  weekLabel   String?
  seoTitle    String?
  seoDescription String?
  author      String    @default("Got Netty")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt])
  @@index([kind])
  @@map("generated_articles")
}

// Global key/value settings (e.g. rankingsLocked, currentSeason).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
