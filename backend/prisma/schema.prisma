// CNCA Rankings Engine — Prisma Schema
// Target: Supabase (PostgreSQL)
// Run: npx prisma migrate dev --name init
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")   // Supabase requires a direct connection for migrations
}

// ─── Reference / lookup tables ───────────────────────────────────────────────

model State {
  id        String   @id @default(uuid())
  code      String   @unique  // NSW, VIC, QLD, etc.
  name      String
  leagues   League[]
  clubs     Club[]
  createdAt DateTime @default(now())

  @@map("states")
}

model Association {
  id           String   @id @default(uuid())
  name         String
  shortName    String?
  stateId      String?
  websiteUrl   String?
  contactEmail String?
  leagues      League[]

  // PlayHQ discovery metadata (automated crawl of the association directory)
  playhqOrgSlug    String?   @unique
  playhqUrl        String?
  logoUrl          String?
  stateCode        String?   // "VIC" | "NSW" … as shown in the directory
  active           Boolean   @default(true)
  lastDiscoveredAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("associations")
}

// ─── League / competition ─────────────────────────────────────────────────────

model League {
  id            String           @id @default(uuid())
  name          String
  shortName     String?
  stateId       String
  associationId String?
  isActive      Boolean          @default(true)

  // League strength (0–100 score the ranking engine consumes). Now DERIVED
  // from finalStrengthRating × 20 — kept so the ranking formula is untouched.
  strengthScore Float            @default(50)  // 0–100  (= finalStrengthRating × 20)
  strengthTier  Int              @default(3)   // 1–5    (= round(finalStrengthRating))
  strengthNotes String?

  // Automatic strength model (0–5). Ranking uses finalStrengthRating via
  // strengthScore. Manual override is optional and wins when set.
  automaticStrengthRating Float   @default(3.0)   // computed from ladder data
  manualStrengthOverride  Float?                  // 0–5, null = no override
  finalStrengthRating     Float   @default(3.0)   // = manualOverride ?? automatic
  strengthConfidence      Float   @default(0.3)   // 0–1

  // Phase 6: explainability — why the league holds its rating, and when it was
  // last computed. Written by every national recalculation.
  strengthReasoning    String?
  strengthCalculatedAt DateTime?

  // PlayHQ discovery metadata (automated). Does NOT affect the ranking formula.
  playhqOrgSlug       String?
  playhqGradeId       String?
  playhqGradeName     String?
  ladderUrl           String?
  currentSeason       String?
  enabled             Boolean   @default(true)   // admin can disable a league
  autoDiscovered      Boolean   @default(false)  // created by the crawler
  needsStrengthReview Boolean   @default(false)  // true until admin sets strength
  gradeOverride       String?   // admin can force a specific grade
  ladderUrlOverride   String?   // admin can pin the ladder URL
  lastSyncedAt        DateTime?
  syncError           String?

  // ── Phase 2: multi-source provenance + admin/status ──────────────────────
  primarySource      String?   // PLAYHQ | NETBALL_CONNECT | COUNTRY_FOOTY | MANUAL_IMAGE | MANUAL | CSV
  importType         String?   @default("AUTO")     // AUTO | MANUAL | IMAGE
  sourceUrl          String?
  status             String    @default("ACTIVE")   // ACTIVE | DISABLED | NEEDS_REVIEW
  lastSuccessAt      DateTime?                        // last successful scrape
  lastManualUpdateAt DateTime?                        // last operator edit
  dataConfidence     Float     @default(0.5)         // 0–1 confidence in the data
  failureCount       Int       @default(0)
  retryCount         Int       @default(0)
  manualOverride     Boolean   @default(false)       // protect from auto imports
  hidden             Boolean   @default(false)       // hide from public site
  regionName         String?                          // country region label
  websiteUrl         String?
  facebookUrl        String?
  logoUrl            String?

  // ── Never-destroy: soft-delete / archive / approval ──────────────────────
  archivedAt     DateTime?                            // soft-deleted / archived
  approvalStatus String    @default("APPROVED")       // PENDING | APPROVED | REJECTED
  leagueType     String?                              // FNL | FANL | STANDALONE_NA | OTHER
  reviewReason   String?

  // Averages (recalculated each cycle)
  avgGoalsPerGame  Float?
  avgMarginPerGame Float?

  // Data sources for automated collection
  sources      LeagueSource[]

  // Relationships
  state        State            @relation(fields: [stateId], references: [id])
  association  Association?     @relation(fields: [associationId], references: [id])
  clubSeasons  ClubLeagueSeason[]
  matches      Match[]
  rankingEntries RankingEntry[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("leagues")
}

// URL/endpoint for each data source per league
model LeagueSource {
  id            String    @id @default(uuid())
  leagueId      String
  sourceType    String    // PLAYHQ | NETBALL_CONNECT | CSV_IMPORT | MANUAL_ENTRY
  ladderUrl     String?
  fixturesUrl   String?
  resultsUrl    String?
  apiKey        String?   // encrypted in production via Supabase Vault
  season        String    // "2025"
  isActive      Boolean   @default(true)
  lastScrapedAt DateTime?
  lastStatus    String?   // SUCCESS | PARTIAL | FAILED | PENDING_REVIEW
  notes         String?

  league     League      @relation(fields: [leagueId], references: [id])
  scrapeLogs ScrapeLog[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("league_sources")
}

// ─── Club ─────────────────────────────────────────────────────────────────────

model Club {
  id              String           @id @default(uuid())
  name            String           // Canonical name
  slug            String           @unique  // "dubbo-netball-club"
  shortName       String?
  stateId         String
  region          String?
  latitude        Float?
  longitude       Float?

  // Brand
  logoUrl         String?
  primaryColour   String?
  secondaryColour String?
  websiteUrl      String?
  facebookUrl     String?
  instagramUrl    String?

  // CNCA status
  cncaQualified    Boolean @default(false)
  invitationStatus String? // null | INVITED | CONFIRMED | DECLINED | WAITLIST

  isActive Boolean @default(true)
  notes    String?

  // Phase 2: manual provenance
  manualOverride Boolean  @default(false)  // protect manual clubs from auto imports
  source         String?                    // origin of this club record
  bestRank       Int?                       // historical best national rank

  // Never-destroy: soft-delete / archive / approval
  archivedAt     DateTime?
  approvalStatus String   @default("APPROVED")  // PENDING | APPROVED | REJECTED
  townName       String?                          // real town this club belongs to

  // Relationships
  state          State            @relation(fields: [stateId], references: [id])
  nameVariants   ClubNameVariant[]
  leagueSeasons  ClubLeagueSeason[]
  homeMatches    Match[]          @relation("HomeClub")
  awayMatches    Match[]          @relation("AwayClub")
  rankingEntries RankingEntry[]
  snapshots      RankingSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clubs")
}

// Known name variants — used by club normaliser to deduplicate scraped data
model ClubNameVariant {
  id         String  @id @default(uuid())
  clubId     String
  rawName    String  // exactly as seen in source data
  sourceType String
  confidence Float   @default(1.0)  // 0–1; <0.8 flagged for human review

  club      Club     @relation(fields: [clubId], references: [id])
  createdAt DateTime @default(now())

  @@unique([rawName, sourceType])
  @@map("club_name_variants")
}

// A club's membership of a league in a specific season
model ClubLeagueSeason {
  id       String  @id @default(uuid())
  clubId   String
  leagueId String
  season   String
  grade    String  @default("A Grade")
  isActive Boolean @default(true)

  // Aggregated season stats (kept in sync by ranking engine)
  played       Int   @default(0)
  wins         Int   @default(0)
  losses       Int   @default(0)
  draws        Int   @default(0)
  goalsFor     Int   @default(0)
  goalsAgainst Int   @default(0)
  percentage   Float @default(0)
  points       Int   @default(0)

  // Advanced-ladder fields (from PlayHQ "Show advanced ladder")
  position          Int?
  byes              Int     @default(0)
  forfeits          Int     @default(0)
  disqualifications Int     @default(0)
  adjustments       Int     @default(0)
  playhqTeamUrl     String?
  playhqTeamId      String?

  // Finals
  finalsWins   Int     @default(0)
  finalsLosses Int     @default(0)
  isPremier    Boolean @default(false)

  club   Club   @relation(fields: [clubId], references: [id])
  league League @relation(fields: [leagueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, leagueId, season, grade])
  @@map("club_league_seasons")
}

// ─── Match ────────────────────────────────────────────────────────────────────

model Match {
  id         String    @id @default(uuid())
  leagueId   String
  homeClubId String
  awayClubId String
  season     String
  round      Int?
  matchDate  DateTime?
  venue      String?
  homeGoals  Int
  awayGoals  Int
  isFinal    Boolean   @default(false)
  finalRound String?   // "QF" | "SF" | "PF" | "GF"
  verified   Boolean   @default(false)

  // Source tracking
  sourceType String
  sourceUrl  String?
  scrapedAt  DateTime?

  league   League @relation(fields: [leagueId], references: [id])
  homeClub Club   @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club   @relation("AwayClub", fields: [awayClubId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

// ─── Ranking engine ───────────────────────────────────────────────────────────

// The weights config for a ranking calculation run.
// Stored so historical rankings can be reproduced exactly.
model RankingConfig {
  id       String  @id @default(uuid())
  label    String  @default("Default")
  isActive Boolean @default(true)

  // Stored as serialised JSON for flexibility
  weights  String  // JSON: { winPercentage: 0.25, ... }

  notes    String?
  runs     RankingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ranking_configs")
}

// One execution of the ranking engine (weekly or manual)
model RankingRun {
  id          String    @id @default(uuid())
  weekLabel   String    // ISO week: "2025-W27"
  season      String    // "2025"
  configId    String?
  status      String    // QUEUED | RUNNING | COMPLETED | FAILED
  clubCount   Int       @default(0)
  completedAt DateTime?
  errorLog    String?   // JSON array of error messages
  notes       String?

  config    RankingConfig?  @relation(fields: [configId], references: [id])
  entries   RankingEntry[]
  snapshots RankingSnapshot[]
  scrapeLogs ScrapeLog[]

  createdAt DateTime @default(now())

  @@index([season, weekLabel])
  @@map("ranking_runs")
}

// The ranking entries for a single run
model RankingEntry {
  id           String  @id @default(uuid())
  runId        String
  clubId       String
  clubName     String
  leagueId     String
  leagueName   String
  state        String

  rank         Int
  previousRank Int?
  rankMovement Int    @default(0)  // +ve = moved up

  powerRating     Float
  componentScores String  // JSON: { winPercentage: 82.3, ... }
  recentForm      String  // JSON: ["W","W","L","W","W"]
  calculatedAt    String

  rankingRun RankingRun @relation(fields: [runId], references: [id])
  club       Club       @relation(fields: [clubId], references: [id])
  league     League     @relation(fields: [leagueId], references: [id])

  createdAt DateTime @default(now())

  @@unique([runId, clubId])
  @@index([state, rank])
  @@index([clubId])
  @@map("ranking_entries")
}

// Immutable weekly snapshot — stored forever for historical graphs
model RankingSnapshot {
  id          String @id @default(uuid())
  runId       String
  clubId      String
  weekLabel   String
  season      String
  rank        Int
  powerRating Float
  movement    Int

  run  RankingRun @relation(fields: [runId], references: [id])
  club Club       @relation(fields: [clubId], references: [id])

  createdAt DateTime @default(now())

  @@unique([weekLabel, clubId])
  @@index([clubId, weekLabel])
  @@map("ranking_snapshots")
}

// ─── Scraping infrastructure ──────────────────────────────────────────────────

model ScrapeLog {
  id             String  @id @default(uuid())
  runId          String?
  leagueSourceId String?
  sourceType     String
  sourceUrl      String?
  status         String  // SUCCESS | PARTIAL | FAILED | PENDING_REVIEW
  recordsFound   Int     @default(0)
  recordsStored  Int     @default(0)
  durationMs     Int?
  errorMessage   String?
  retryCount     Int     @default(0)
  scrapedAt      DateTime @default(now())

  run          RankingRun?   @relation(fields: [runId], references: [id])
  leagueSource LeagueSource? @relation(fields: [leagueSourceId], references: [id])

  @@map("scrape_logs")
}

// Human-review queue for data that couldn't be automatically resolved
model ReviewQueue {
  id                String    @id @default(uuid())
  type              String    // CLUB_MATCH | MISSING_LEAGUE | NAME_CONFLICT | STAT_ANOMALY
  severity          String    @default("WARNING")  // INFO | WARNING | ERROR
  description       String
  rawData           String?   // JSON
  status            String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  resolvedCanonical String?
  resolvedBy        String?
  resolvedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())

  @@map("review_queue")
}

// ─── Admin / auth ─────────────────────────────────────────────────────────────

model AdminUser {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  role        String    @default("VIEWER")  // VIEWER | EDITOR | ADMIN | SUPERADMIN
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  auditLogs   AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // e.g. "UPDATE_LEAGUE_STRENGTH", "TRIGGER_RANKING_RUN"
  entityType String?  // e.g. "League", "Club"
  entityId   String?
  before     String?  // JSON
  after      String?  // JSON
  ipAddress  String?
  source     String?  // ADMIN | OCR | PLAYHQ | CSV | SYSTEM
  reason     String?  // optional human reason
  createdAt  DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// Nothing uncertain publishes automatically — it enters this queue.
model ReviewItem {
  id         String    @id @default(uuid())
  entityType String    // League | Club | Ladder | Ranking | Logo
  entityId   String?
  kind       String    // UNKNOWN_LEAGUE | DUPLICATE_CLUB | LOW_CONFIDENCE_OCR | NAME_CHANGE | LADDER_CHANGE | MISSING_LOGO | STRENGTH_UNCERTAIN
  reason     String
  confidence Float?     // 0–1 where applicable
  payload    String?    // JSON — the proposed change / context
  status     String    @default("PENDING")  // PENDING | APPROVED | REJECTED | MERGED | IGNORED
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([status])
  @@map("review_items")
}

// One-click backups / restore points (full JSON snapshot of core tables).
model Backup {
  id        String   @id @default(uuid())
  label     String
  kind      String   @default("MANUAL")  // MANUAL | NIGHTLY | PRE_RESTORE
  counts    String?  // JSON summary { leagues, clubs, ... }
  data      String   // JSON dump of core tables
  createdAt DateTime @default(now())

  @@map("backups")
}

// OCR image imports (Phase 3) — every ladder image ever uploaded is kept:
// original image, extraction, confidence, what was committed, when, by whom.
// Never deleted — discarded imports are status DISCARDED, not removed.
model OcrImport {
  id             String    @id @default(uuid())
  leagueId       String?
  leagueName     String?                       // resolved league at commit time
  image          String                        // original data-URL / base64 image
  detectedLeague String?                       // what the OCR read off the image
  detectedGrade  String?
  rowCount       Int       @default(0)
  uncertainCount Int       @default(0)         // rows without a confident club match
  confidence     Float?                        // mean club-match score (0–1)
  rows           String?                       // JSON: extracted + matched preview rows
  committedRows  String?                       // JSON: what the operator actually applied
  status         String    @default("PREVIEWED") // PREVIEWED | COMMITTED | DISCARDED
  notes          String?
  createdBy      String    @default("admin")
  createdAt      DateTime  @default(now())
  committedAt    DateTime?

  @@index([leagueId])
  @@index([createdAt])
  @@map("ocr_imports")
}

// AI Publishing: generated article drafts. Body is built from real ranking data
// (templated prose over actual numbers), reviewed in the admin portal, then
// published. Status flows DRAFT → APPROVED → PUBLISHED (never destroyed).
model GeneratedArticle {
  id          String    @id @default(uuid())
  slug        String    @unique
  kind        String                       // NATIONAL_ROUNDUP | BIGGEST_MOVERS | STRONGEST_LEAGUES | LEAGUE_ROUNDUP | CLUB_UPDATE
  category    String    @default("rankings")
  title       String
  subtitle    String?
  summary     String
  body        String                       // JSON: Block[] (p/h/quote), same shape as the news model
  heroSeed    String    @default("rankings")
  tags        String?                      // JSON: { state?, league?, leagueId?, club?, clubId? }
  status      String    @default("DRAFT")  // DRAFT | APPROVED | PUBLISHED | ARCHIVED
  runId       String?                      // ranking run this was generated from
  weekLabel   String?
  seoTitle    String?
  seoDescription String?
  author      String    @default("Got Netty")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Phase B3 — editorial reasoning (nullable; existing rows/generators unaffected)
  confidence  Float?                       // 0–1 overall confidence in the story
  reasoning   String?                      // why this article exists (human-readable)
  triggers    String?                      // JSON: which trigger rules / signals fired
  sourceData  String?                      // JSON: the exact stats it was derived from
  dedupeKey   String?                      // stable key for duplicate detection

  @@index([status, publishedAt])
  @@index([kind])
  @@map("generated_articles")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B3 — Intelligent News & Content Engine (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Backend intelligence layer. Analyses real ranking / ladder / history data to
// detect what changed, why, and what is newsworthy, then records the reasoning.
// New tables only; no ranking table is modified. Nothing is exposed in the UI.
// ═════════════════════════════════════════════════════════════════════════════

// A single detected newsworthy signal (the output of the trigger engine). Stores
// the editorial reasoning: which rule fired, which stats triggered it, the clubs
// / rankings that changed, confidence and the exact source data. dedupeKey makes
// duplicate stories impossible (same topic + scope + week + subject).
model NewsSignal {
  id          String   @id @default(uuid())
  weekLabel   String
  season      String?
  kind        String   // BIGGEST_RISE | NEW_NUMBER_ONE | LEAGUE_STRENGTH_CHANGE | UNDEFEATED | TOP10_ENTRY | HISTORIC_BEST | …
  scope       String   // NATIONAL | LEAGUE | CLUB
  headline    String   // one-line human summary
  clubId      String?
  clubName    String?
  leagueId    String?
  leagueName  String?
  state       String?
  metrics     String?  // JSON — the numbers behind the signal
  triggerRule String   // the rule id that produced this signal
  sourceData  String?  // JSON — raw rows used (audit / never-invent trail)
  confidence  Float    @default(0.8) // 0–1
  priority    Int      @default(0)   // higher = more newsworthy
  dedupeKey   String   @unique       // scope+kind+week+subject
  usedInArticle Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([weekLabel])
  @@index([kind])
  @@index([scope])
  @@map("news_signals")
}

// Weekly league-strength history so "strength change / most improved / highest
// ever" can be derived. One row per league per week (idempotent by unique key).
model LeagueStrengthSnapshot {
  id            String   @id @default(uuid())
  leagueId      String
  leagueName    String
  weekLabel     String
  season        String?
  strengthScore Float
  strengthTier  Int
  rankedClubs   Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([leagueId, weekLabel])
  @@index([leagueId])
  @@index([weekLabel])
  @@map("league_strength_snapshots")
}

// Computed per-club trend metrics (for future frontend). Refreshed each run.
model ClubTrend {
  id             String   @id @default(uuid())
  clubId         String   @unique
  clubName       String
  leagueName     String?
  state          String?
  currentRank    Int?
  bestRankEver   Int?
  worstRankEver  Int?
  rank4wkDelta   Int?     // rank change over the last ~4 weeks (+ve = improved)
  ratingTrend    Float?   // slope of power rating over recent weeks
  consistency    Float?   // inverse of rank stddev (higher = steadier)
  volatility     Float?   // rank stddev over recent weeks
  momentum       Float?   // short-term rating momentum
  weeksTracked   Int      @default(0)
  isRising       Boolean  @default(false)
  isFalling      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([isRising])
  @@index([isFalling])
  @@map("club_trends")
}

// Editorial calendar — recurring publishing plan (backend scheduling only).
model EditorialCalendarSlot {
  id          String   @id @default(uuid())
  dayOfWeek   Int      // 0=Sun … 6=Sat
  slotKey     String   @unique // MONDAY_RANKINGS | TUESDAY_LEAGUE_ROUNDUPS | …
  label       String
  articleKind String   // which article kind this slot produces
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("editorial_calendar_slots")
}

// Interconnects an article to the entities it is about (club/league/state/…).
model ArticleLink {
  id         String   @id @default(uuid())
  articleId  String
  entityType String   // CLUB | LEAGUE | STATE | RANKING | SEASON | RECORD | SIGNAL
  entityId   String?
  label      String?
  createdAt  DateTime @default(now())

  @@index([articleId])
  @@index([entityType, entityId])
  @@map("article_links")
}

// Backend search index (future search; no frontend). One row per indexed doc.
model SearchDoc {
  id         String   @id @default(uuid())
  entityType String   // ARTICLE | CLUB | LEAGUE
  entityId   String
  title      String
  body       String   // flattened searchable text
  tags       String?  // JSON
  state      String?
  weight     Float    @default(1)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
  @@map("search_docs")
}

// Global key/value settings (e.g. rankingsLocked, currentSeason).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ═════════════════════════════════════════════════════════════════════════════
// LADDER IMPORT V2 — stored ladders (uploaded/OCR/CSV/manual OR generated from
// results) + editable rows. Manual/uploaded ladders are protected; a generated
// ladder that disagrees raises a comparison review item. Additive; feeds
// rankings/profiles/articles/summaries via safe input hooks. Soft-delete only.
// ═════════════════════════════════════════════════════════════════════════════

model Ladder {
  id              String    @id @default(uuid())
  leagueId        String
  leagueName      String?
  season          String
  grade           String    @default("A Grade")
  source          String    @default("MANUAL") // PLAYHQ | OCR | CSV | MANUAL | GENERATED_FROM_RESULTS
  status          String    @default("DRAFT")   // DRAFT | CURRENT | SUPERSEDED | REVIEW
  isCurrent       Boolean   @default(false)
  manualOverride  Boolean   @default(false)     // uploaded/manual ladders are protected
  roundFrom       Int?
  roundTo         Int?
  resultsIncluded Int       @default(0)
  winPoints       Int       @default(4)
  drawPoints      Int       @default(2)
  confidence      Float?
  warnings        String?   // JSON string[]
  notes           String?
  generatedAt     DateTime?
  createdBy       String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rows            LadderRow[]

  @@index([leagueId, season, grade])
  @@index([leagueId, isCurrent])
  @@index([source])
  @@map("ladders")
}

model LadderRow {
  id            String   @id @default(uuid())
  ladderId      String
  position      Int?
  clubId        String?
  clubName      String
  played        Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  goalDiff      Int      @default(0)
  percentage    Float    @default(0)
  points        Int      @default(0)
  last5         String?  // JSON: ["W","L",…] most-recent first
  currentStreak Int      @default(0)
  sourceNotes   String?
  createdAt     DateTime @default(now())

  ladder        Ladder   @relation(fields: [ladderId], references: [id])

  @@index([ladderId])
  @@index([clubId])
  @@map("ladder_rows")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B11 — Analytics & Insights Engine (ADDITIVE, PRIVACY-CONSCIOUS)
// ─────────────────────────────────────────────────────────────────────────────
// Go Netty's own lightweight analytics: anonymous event tracking + search logs,
// aggregated into per-entity popularity, search-term stats and daily visitor
// rollups. No PII — no passwords, admin keys, emails or raw IPs are stored; the
// visitor id is an anonymous (salted-hash or client-supplied) token. New tables
// only; nothing existing is modified.
// ═════════════════════════════════════════════════════════════════════════════

// A raw, anonymous interaction event.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String   // CLUB_VIEW | LEAGUE_VIEW | ARTICLE_VIEW | SEARCH | SPONSOR_CLICK | …
  entityType String?  // CLUB | LEAGUE | ARTICLE | SPONSOR | RANKINGS | …
  entityId   String?
  sessionId  String?  // anonymous session token
  visitorId  String?  // anonymous visitor token (salted hash / client id)
  referrer   String?
  path       String?
  deviceType String?  // MOBILE | TABLET | DESKTOP | BOT | UNKNOWN
  browser    String?  // coarse UA family
  country    String?  // future
  state      String?  // future
  meta       String?  // JSON — small, non-PII context
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([visitorId])
  @@index([sessionId])
  @@map("analytics_events")
}

// A raw search query log (anonymous).
model SearchQuery {
  id             String   @id @default(uuid())
  term           String
  normalizedTerm String
  scope          String?  // ALL | CLUB | LEAGUE
  resultCount    Int      @default(0)
  zeroResult     Boolean  @default(false)
  sessionId      String?
  visitorId      String?
  createdAt      DateTime @default(now())

  @@index([normalizedTerm])
  @@index([createdAt])
  @@index([zeroResult])
  @@map("search_queries")
}

// Aggregated popularity per entity per time window (rebuildable cache).
model EntityPopularity {
  id            String   @id @default(uuid())
  entityType    String   // CLUB | LEAGUE | ARTICLE
  entityId      String
  entityName    String?
  windowKey     String   // ALL | ROLL7 | ROLL30
  views         Int      @default(0)
  uniqueVisitors Int     @default(0)
  searches      Int      @default(0)
  sponsorClicks Int      @default(0)
  score         Float    @default(0)   // weighted popularity
  trendScore    Float    @default(0)   // growth vs previous window
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([entityType, entityId, windowKey])
  @@index([entityType, windowKey])
  @@map("entity_popularity")
}

// Aggregated search-term stats per window (rebuildable cache).
model SearchTermStat {
  id             String   @id @default(uuid())
  normalizedTerm String
  term           String
  windowKey      String   // ALL | ROLL7 | ROLL30
  searches       Int      @default(0)
  zeroResults    Int      @default(0)
  uniqueVisitors Int      @default(0)
  trendScore     Float    @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([normalizedTerm, windowKey])
  @@index([windowKey])
  @@map("search_term_stats")
}

// Daily visitor rollup.
model AnalyticsDaily {
  id             String   @id @default(uuid())
  day            String   @unique // YYYY-MM-DD
  visitors       Int      @default(0)
  sessions       Int      @default(0)
  events         Int      @default(0)
  searches       Int      @default(0)
  returningVisitors Int   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([day])
  @@map("analytics_daily")
}

// Audit of aggregation runs.
model AnalyticsRun {
  id        String   @id @default(uuid())
  kind      String   @default("AGGREGATE")
  events    Int      @default(0)
  entities  Int      @default(0)
  terms     Int      @default(0)
  days      Int      @default(0)
  detail    String?
  ranAt     DateTime @default(now())

  @@index([ranAt])
  @@map("analytics_runs")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B9 — Notifications & Automation Engine (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Backend alerting: an event-driven notification store + delivery status, per-
// recipient preferences, type rules, and an automation-scan audit. The scanner
// reads existing data (rankings, articles, claims, sponsors, championships,
// review queue, syncs) READ-ONLY and emits deduplicated notifications. New
// tables only; distinct from the B2 platform_notifications table.
// ═════════════════════════════════════════════════════════════════════════════

// A single notification (in-app by default; email/webhook are future channels).
model Notification {
  id            String    @id @default(uuid())
  recipientScope String   @default("ADMIN") // ADMIN | CLUB | LEAGUE | USER | PLATFORM
  recipientId   String?                      // clubId / leagueId / userId; null = broadcast to scope
  type          String                       // RANKINGS_UPDATED | CLUB_MOVED_UP | …
  category      String?                      // RANKINGS | CLUB | LEAGUE | CONTENT | CLAIMS | COMMERCIAL | CHAMPIONSHIP | QUALITY | SYSTEM
  severity      String    @default("INFO")   // INFO | SUCCESS | WARNING | CRITICAL
  title         String
  body          String?
  entityType    String?
  entityId      String?
  data          String?                       // JSON payload
  channel       String    @default("IN_APP")  // IN_APP | EMAIL | WEBHOOK
  status        String    @default("PENDING")  // PENDING | QUEUED | SENT | DELIVERED | READ | FAILED | SUPPRESSED
  dedupeKey     String    @unique
  readAt        DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientScope, recipientId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@map("notifications")
}

// Per-recipient opt-in/out for a notification type + channel. Phase B9b adds
// optional scoping (club / league / state) + delivery frequency so a recipient
// can subscribe narrowly (e.g. only a given league, weekly digest).
model NotificationPreference {
  id             String   @id @default(uuid())
  recipientScope String
  recipientId    String
  type           String
  channel        String   @default("IN_APP") // IN_APP | EMAIL | WEBHOOK | PUSH | SMS
  enabled        Boolean  @default(true)
  clubId         String?  // optional: restrict this preference to a club
  leagueId       String?  // optional: restrict to a league
  state          String?  // optional: restrict to a state
  frequency      String   @default("INSTANT") // INSTANT | DAILY | WEEKLY | OFF
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([recipientScope, recipientId, type, channel])
  @@index([recipientScope, recipientId])
  @@index([clubId])
  @@index([leagueId])
  @@map("notification_preferences")
}

// Digest run (daily admin / weekly rankings / weekly club / weekly league).
// Generated content is stored; nothing is sent unless a real transport exists —
// dryRun records the digest without dispatching.
model NotificationDigest {
  id             String   @id @default(uuid())
  kind           String   // DAILY_ADMIN | WEEKLY_RANKINGS | WEEKLY_CLUB | WEEKLY_LEAGUE
  recipientScope String   @default("ADMIN")
  recipientId    String?
  periodStart    DateTime
  periodEnd      DateTime
  itemCount      Int      @default(0)
  content        String   // JSON — the assembled digest
  channel        String   @default("EMAIL")
  status         String   @default("DRY_RUN") // DRY_RUN | DRAFT | SENT
  dryRun         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
  @@map("notification_digests")
}

// Rule/template for a notification type (default channels, recipients, copy).
model NotificationRule {
  id              String   @id @default(uuid())
  type            String   @unique
  label           String
  category        String?
  severity        String   @default("INFO")
  recipientScope  String   @default("ADMIN")
  defaultChannels String   @default("[\"IN_APP\"]") // JSON string[]
  subjectTemplate String?
  bodyTemplate    String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_rules")
}

// Audit of automation scans (what was emitted / deduped).
model AutomationRun {
  id        String   @id @default(uuid())
  scanKey   String   // FULL | RANKINGS | CLAIMS | …
  status    String   @default("SUCCESS") // SUCCESS | PARTIAL | FAILED
  created   Int      @default(0)
  deduped   Int      @default(0)
  detail    String?  // JSON
  ranAt     DateTime @default(now())

  @@index([scanKey])
  @@index([ranAt])
  @@map("automation_runs")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B8 — Sponsorship & Commercial Platform (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Commercial backend: sponsor businesses, sponsorship deals, tiers, ad inventory,
// premium memberships and a workflow event ledger. New tables only; nothing
// affects rankings. Distinct names from the B2 `sponsors` table (no collision).
// Soft-delete only — sponsorship history is never removed. Commercial actions
// are logged to the existing AuditLog (source = COMMERCIAL).
// ═════════════════════════════════════════════════════════════════════════════

// A sponsor business entity (the advertiser). Media are stored as references.
model CommercialSponsor {
  id           String    @id @default(uuid())
  name         String
  businessName String?
  logoUrl      String?
  heroImageUrl String?
  bannerUrl    String?
  squareLogoUrl String?
  websiteUrl   String?
  email        String?
  phone        String?
  description  String?
  industry     String?
  state        String?
  tier         String?   // references SponsorTier.key (or free text)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  // Brand + social (references only)
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  brandPrimary   String?
  brandSecondary String?
  notes        String?
  deletedAt    DateTime? // soft delete only
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([state])
  @@index([industry])
  @@map("commercial_sponsors")
}

// A sponsorship deal linking a sponsor to a club / league / championship / platform.
model Sponsorship {
  id             String    @id @default(uuid())
  sponsorId      String
  scope          String    @default("CLUB") // CLUB | LEAGUE | CHAMPIONSHIP | PLATFORM
  clubId         String?
  leagueId       String?
  championshipId String?
  package        String?   // package/tier name for this deal
  tier           String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | EXPIRED | RENEWAL_DUE | VERIFICATION_REQUIRED | AWAITING_PAYMENT | PAYMENT_COMPLETE | CANCELLED
  startDate      DateTime?
  endDate        DateTime?
  displayPriority Int      @default(0)
  bannerPosition String?   // future banner slot
  ctaLabel       String?   // future call-to-action
  ctaUrl         String?
  trackingId     String?   // future impression/click tracking
  amount         Float?    // deal value (commercial reporting)
  currency       String    @default("AUD")
  approvedBy     String?
  createdBy      String?
  notes          String?
  deletedAt      DateTime? // soft delete only — history is never removed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sponsorId])
  @@index([scope, status])
  @@index([clubId])
  @@index([leagueId])
  @@index([championshipId])
  @@index([endDate])
  @@map("sponsorships")
}

// Sponsor tier definitions (seeded defaults + custom tiers).
model SponsorTier {
  id           String   @id @default(uuid())
  key          String   @unique // BRONZE | SILVER | GOLD | PLATINUM | FOUNDING_PARTNER | NAMING_RIGHTS | custom…
  label        String
  rank         Int      @default(0) // display/importance order
  description  String?
  benefits     String?  // JSON
  isCustom     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sponsor_tiers")
}

// Advertising inventory location (a bookable slot).
model AdInventory {
  id             String    @id @default(uuid())
  placement      String    // HOMEPAGE_HERO | HOMEPAGE_SIDEBAR | RANKINGS_SIDEBAR | LEAGUE_PAGE | CLUB_PAGE | NEWS_PAGE | CHAMPIONSHIP_PAGE | SEARCH_PAGE | STATISTICS_PAGE
  label          String
  priority       Int       @default(0)
  available      Boolean   @default(true)
  bookingStart   DateTime?
  bookingEnd     DateTime?
  activeSponsorshipId String?
  rotationGroup  String?   // future rotation bucket
  maxRotation    Int       @default(1)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement])
  @@index([available])
  @@map("ad_inventory")
}

// Premium membership / subscription layer for a club or league (additive to the
// B2 ClubProfile flags — this holds the subscription + benefits detail).
model PremiumMembership {
  id               String    @id @default(uuid())
  scope            String    // CLUB | LEAGUE
  entityId         String    // clubId or leagueId
  entityName       String?
  premiumStatus    String    @default("NONE") // NONE | TRIAL | ACTIVE | PAST_DUE | CANCELLED
  verified         Boolean   @default(false)
  claimed          Boolean   @default(false)
  featured         Boolean   @default(false)
  subscriptionPlan String?   // free | starter | pro | elite
  startedAt        DateTime?
  expiresAt        DateTime?
  renewalDate      DateTime?
  autoRenew        Boolean   @default(false)
  benefits         String?   // JSON
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([scope, entityId])
  @@index([premiumStatus])
  @@map("premium_memberships")
}

// Workflow event ledger for a sponsorship (status transitions, future-ready).
model SponsorshipEvent {
  id            String   @id @default(uuid())
  sponsorshipId String
  fromStatus    String?
  toStatus      String
  note          String?
  actor         String?
  createdAt     DateTime @default(now())

  @@index([sponsorshipId])
  @@map("sponsorship_events")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B7 — Championship Qualification & Tournament Engine (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Backend foundation for future Go Netty championships. No live tournament is
// created here. New tables only; ranking/history tables are read-only sources.
// Championship + invitation history is permanent (soft-archive only).
// ═════════════════════════════════════════════════════════════════════════════

model Championship {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  year           Int?
  division       String    @default("OPEN")   // OPEN | U17 | B_GRADE | WOMENS | …
  grade          String?
  season         String?
  status         String    @default("DRAFT")  // DRAFT | QUALIFYING | INVITING | LOCKED | LIVE | COMPLETE | ARCHIVED
  maxTeams       Int       @default(16)
  qualificationCutoff Int?                     // e.g. top N national rank auto-qualifies
  description    String?
  venueId        String?
  startDate      DateTime?
  endDate        DateTime?
  archivedAt     DateTime?                     // soft delete only
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([year])
  @@map("championships")
}

// A qualification method + its quota for a championship.
model QualificationRule {
  id             String   @id @default(uuid())
  championshipId String
  method         String   // TOP_RANKING | LEAGUE_CHAMPION | WILDCARD | HOST_INVITATION | MANUAL_INVITATION | RETURNING_CHAMPION | ADMIN_OVERRIDE
  priority       Int      @default(0)   // lower = applied first
  quota          Int?                    // max clubs via this method (null = unlimited)
  params         String?  // JSON — method-specific config
  createdAt      DateTime @default(now())

  @@index([championshipId])
  @@map("qualification_rules")
}

// Immutable snapshot of the exact rankings used when qualification was generated.
model QualificationSnapshot {
  id             String   @id @default(uuid())
  championshipId String
  runId          String?
  weekLabel      String?
  season         String?
  data           String   // JSON — the ranked list used, frozen forever
  generatedBy    String?
  createdAt      DateTime @default(now())

  @@index([championshipId])
  @@map("qualification_snapshots")
}

// A club's qualification standing for a championship (qualified / reserve / …).
model QualifiedClub {
  id             String   @id @default(uuid())
  championshipId String
  clubId         String
  clubName       String
  method         String   // which QualificationRule.method qualified them
  status         String   @default("QUALIFIED") // QUALIFIED | RESERVE | WAITLIST | REPLACEMENT | REMOVED
  order          Int      @default(0)           // ordering within the pool/waitlist
  state          String?
  leagueId       String?
  leagueName     String?
  snapshotRank   Int?                            // national rank at qualification
  snapshotRating Float?
  snapshotId     String?                         // the QualificationSnapshot used
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([championshipId, clubId])
  @@index([championshipId, status])
  @@map("qualified_clubs")
}

// Permanent invitation ledger — never hard-deleted; status carries the history.
model ChampionshipInvitation {
  id             String    @id @default(uuid())
  championshipId String
  clubId         String
  clubName       String
  invitationType String    @default("QUALIFICATION") // QUALIFICATION | WILDCARD | HOST | MANUAL | REPLACEMENT
  status         String    @default("PENDING")       // PENDING | ACCEPTED | DECLINED | WITHDRAWN | EXPIRED
  invitedAt      DateTime  @default(now())
  respondedAt    DateTime?
  reason         String?
  notes          String?
  invitedBy      String?
  snapshotId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([championshipId, status])
  @@index([clubId])
  @@map("championship_invitations")
}

model Venue {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  state              String?
  capacity           Int?
  courtCount         Int?
  indoorOutdoor      String?  // INDOOR | OUTDOOR | MIXED
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  accommodationNotes String?
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("venues")
}

// A team a club fields in a championship (no player lists yet).
model ChampionshipTeam {
  id             String   @id @default(uuid())
  championshipId String
  clubId         String
  clubName       String
  division       String?
  coach          String?
  manager        String?
  captain        String?
  colours        String?
  status         String   @default("REGISTERED") // REGISTERED | CONFIRMED | WITHDRAWN
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([championshipId, clubId, division])
  @@index([championshipId])
  @@map("championship_teams")
}

// Tournament structure — pools (models only; no fixtures generated yet).
model ChampionshipPool {
  id             String   @id @default(uuid())
  championshipId String
  name           String
  createdAt      DateTime @default(now())

  @@index([championshipId])
  @@map("championship_pools")
}

// A tournament fixture (also stores its result). Stage covers pools → finals.
model ChampionshipFixture {
  id             String    @id @default(uuid())
  championshipId String
  poolId         String?
  stage          String    @default("POOL") // POOL | ROUND | QF | SF | GF | THIRD_PLACE
  round          Int?
  homeTeamId     String?
  awayTeamId     String?
  homeClubName   String?
  awayClubName   String?
  venueId        String?
  scheduledAt    DateTime?
  status         String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | CANCELLED
  homeScore      Int?
  awayScore      Int?
  winnerTeamId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([championshipId])
  @@index([championshipId, stage])
  @@map("championship_fixtures")
}

// Derived pool/championship ladder.
model ChampionshipLadder {
  id             String   @id @default(uuid())
  championshipId String
  poolId         String?
  teamId         String
  clubName       String
  played         Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  draws          Int      @default(0)
  pointsFor      Int      @default(0)
  pointsAgainst  Int      @default(0)
  points         Int      @default(0)
  position       Int?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([championshipId, poolId, teamId])
  @@index([championshipId])
  @@map("championship_ladders")
}

// Permanent, immutable record of a completed championship's outcome.
model ChampionshipHistory {
  id             String   @id @default(uuid())
  championshipId String   @unique
  championshipName String
  year           Int?
  championClubId String?
  championName   String?
  runnerUpClubId String?
  runnerUpName   String?
  thirdClubId    String?
  thirdName      String?
  finalRankings  String?  // JSON
  awards         String?  // JSON
  qualifiedClubs String?  // JSON snapshot of who qualified
  createdAt      DateTime @default(now())

  @@map("championship_history")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B6 — Historical Rankings & Records Engine (ADDITIVE, IMMUTABLE)
// ─────────────────────────────────────────────────────────────────────────────
// Permanent, append-only archive of every weekly ranking run + derived club and
// league histories + a computed record book. History rows are never overwritten
// (unique per week+entity, writes skip if present). Existing ranking tables are
// read-only sources; nothing existing is modified.
// ═════════════════════════════════════════════════════════════════════════════

// Immutable per-club, per-week ranking archive. One row per (weekLabel, clubId),
// written once and never overwritten.
model RankingHistory {
  id            String   @id @default(uuid())
  runId         String
  weekLabel     String
  season        String
  snapshotDate  DateTime @default(now())
  clubId        String
  clubName      String
  leagueId      String?
  leagueName    String?
  state         String?
  rank          Int
  previousRank  Int?
  rankMovement  Int      @default(0)
  powerRating   Float
  leagueStrength Float?
  reasoning     String?
  engineVersion String   @default("v2")
  calcVersion   String   @default("default")
  createdAt     DateTime @default(now())

  @@unique([weekLabel, clubId])
  @@index([clubId])
  @@index([weekLabel])
  @@index([season])
  @@index([clubId, weekLabel])
  @@map("ranking_history")
}

// Immutable per-league, per-week ranking archive.
model LeagueRankingHistory {
  id            String   @id @default(uuid())
  runId         String?
  weekLabel     String
  season        String
  snapshotDate  DateTime @default(now())
  leagueId      String
  leagueName    String
  state         String?
  leagueRank    Int?     // position among leagues by strength that week
  strengthScore Float
  strengthTier  Int
  rankedClubs   Int      @default(0)
  top25Clubs    Int      @default(0)
  top100Clubs   Int      @default(0)
  reasoning     String?
  engineVersion String   @default("v2")
  createdAt     DateTime @default(now())

  @@unique([weekLabel, leagueId])
  @@index([leagueId])
  @@index([weekLabel])
  @@index([season])
  @@map("league_ranking_history")
}

// Derived per-club career aggregates (a rebuildable cache over ranking_history).
model ClubHistory {
  id                      String   @id @default(uuid())
  clubId                  String   @unique
  clubName                String
  highestRank             Int?
  lowestRank              Int?
  avgRank                 Float?
  weeksRanked             Int      @default(0)
  weeksTop10              Int      @default(0)
  weeksTop25              Int      @default(0)
  weeksTop50              Int      @default(0)
  weeksTop100             Int      @default(0)
  longestConsecutiveWeeks Int      @default(0)
  longestTop10Run         Int      @default(0)
  largestWeeklyRise       Int?
  largestWeeklyFall       Int?
  highestRating           Float?
  avgRating               Float?
  firstWeek               String?
  lastWeek                String?
  timeline                String?  // JSON: [{ week, rank, rating, movement }]
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())

  @@map("club_history")
}

// Derived per-league history aggregates.
model LeagueHistory {
  id             String   @id @default(uuid())
  leagueId       String   @unique
  leagueName     String
  highestRank    Int?
  lowestRank     Int?
  avgStrength    Float?
  highestStrength Float?
  weeksRanked    Int      @default(0)
  maxRankedClubs Int      @default(0)
  maxTop25       Int      @default(0)
  maxTop100      Int      @default(0)
  timeline       String?  // JSON: [{ week, rank, strength, rankedClubs }]
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("league_history")
}

// Computed record book. One row per record kind (upserted each run).
model RecordBookEntry {
  id         String   @id @default(uuid())
  kind       String   @unique
  title      String
  entityType String   // CLUB | LEAGUE
  entityId   String?
  entityName String?
  value      Float?
  valueLabel String?
  weekLabel  String?
  season     String?
  metrics    String?  // JSON
  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("record_book_entries")
}

// Correction ledger — history is immutable, so a correction is a NEW record that
// documents the change; the original archive row is never rewritten.
model HistoryCorrection {
  id          String   @id @default(uuid())
  weekLabel   String
  entityType  String   // CLUB | LEAGUE
  entityId    String
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([weekLabel])
  @@map("history_corrections")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B5 — Results & Fixtures Engine (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// A dedicated results/fixtures store that all import sources (PlayHQ, OCR, CSV,
// manual) feed. New tables only — the existing `matches` table and every ranking
// table are left untouched. Club/league are referenced by plain indexed columns
// (no relation into existing models), so nothing existing changes.
// ═════════════════════════════════════════════════════════════════════════════

// A completed match result. Deduped by (league, season, round, home, away).
model MatchResult {
  id            String    @id @default(uuid())
  sourceMatchId String?   // optional link to a legacy matches.id it was bridged from
  fixtureId     String?   // B10: link to the Fixture this result belongs to
  leagueId      String
  leagueName    String
  season        String
  grade         String    @default("A Grade") // B10
  round         Int?
  matchDate     DateTime?
  sourceUrl     String?   // B10: provenance URL
  importedAt    DateTime? // B10: when this result was imported
  homeClubId    String
  homeClubName  String
  awayClubId    String
  awayClubName  String
  homeScore     Int
  awayScore     Int
  winnerClubId  String?   // null when a draw
  isDraw        Boolean   @default(false)
  margin        Int       @default(0)
  status        String    @default("FINAL")   // FINAL | PROVISIONAL | FORFEIT | VOID
  importSource  String    @default("MANUAL")  // PLAYHQ | OCR | CSV | MANUAL | MATCH_BRIDGE
  verified      Boolean   @default(false)
  manualOverride Boolean  @default(false)      // protect from auto re-imports
  notes         String?
  dedupeKey     String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leagueId, season])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([season, round])
  @@index([leagueId, season, grade, round])
  @@index([fixtureId])
  @@index([matchDate])
  @@map("match_results")
}

// A scheduled fixture (stored independently from results; supports live scores).
model Fixture {
  id            String    @id @default(uuid())
  leagueId      String
  leagueName    String
  season        String
  grade         String    @default("A Grade") // B10
  round         Int?
  matchDate     DateTime?
  matchTime     String?
  venue         String?
  sourceUrl     String?   // B10: provenance URL
  importedAt    DateTime? // B10: when this fixture was imported
  homeClubId    String
  homeClubName  String
  awayClubId    String
  awayClubName  String
  status        String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | POSTPONED | CANCELLED
  homeScore     Int?      // populated for live/completed
  awayScore     Int?
  resultId      String?   // link to the MatchResult once played
  importSource  String    @default("MANUAL")
  manualOverride Boolean  @default(false)
  dedupeKey     String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leagueId, season])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([status])
  @@index([leagueId, season, grade, round])
  @@index([matchDate])
  @@map("fixtures")
}

// Round-by-round league summary (B10). Derived from MatchResult; one row per
// (league, season, grade, round). ladderImpact / rankingImpact are JSON outputs
// prepared for future ladder + ranking integration (data only).
model RoundSummary {
  id            String   @id @default(uuid())
  leagueId      String
  leagueName    String?
  season        String
  grade         String   @default("A Grade")
  round         Int
  matchesPlayed Int      @default(0)
  highestScore  Int      @default(0)
  lowestScore   Int      @default(0)
  closestMargin Int      @default(0)
  biggestMargin Int      @default(0)
  averageMargin Float    @default(0)
  upsetDetected Boolean  @default(false)
  ladderImpact  String?  // JSON
  rankingImpact String?  // JSON
  articleData   String?  // JSON — round-wrap / biggest-win / upset outputs for the article engine
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([leagueId, season, grade, round])
  @@index([leagueId, season])
  @@index([round])
  @@map("round_summaries")
}

// Stored match intelligence (biggest win, upset, match of the round, …).
model MatchInsight {
  id        String   @id @default(uuid())
  season    String
  leagueId  String?
  round     Int?
  kind      String   // BIGGEST_WIN | CLOSEST_MATCH | HIGHEST_SCORING | LOWEST_SCORING | MATCH_OF_ROUND | UPSET | DRAW
  resultId  String?
  headline  String
  metrics   String?  // JSON
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([season])
  @@index([kind])
  @@map("match_insights")
}

// Per-club per-season match statistics (derived from MatchResult). Backend only.
model ClubMatchStat {
  id                  String   @id @default(uuid())
  clubId              String
  clubName            String
  season              String
  played              Int      @default(0)
  wins                Int      @default(0)
  losses              Int      @default(0)
  draws               Int      @default(0)
  goalsFor            Int      @default(0)
  goalsAgainst        Int      @default(0)
  goalDiff            Int      @default(0)
  percentage          Float    @default(0)
  avgWinningMargin    Float    @default(0)
  largestWinningMargin Int     @default(0)
  homeWins            Int      @default(0)
  homeLosses          Int      @default(0)
  homeDraws           Int      @default(0)
  awayWins            Int      @default(0)
  awayLosses          Int      @default(0)
  awayDraws           Int      @default(0)
  currentStreak       Int      @default(0)   // +ve = win streak, -ve = loss streak
  currentStreakType   String?                // W | L | D
  longestWinStreak    Int      @default(0)
  longestLossStreak   Int      @default(0)
  last5               String?  // JSON: ["W","L",…] most-recent first
  last10              String?  // JSON
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([clubId, season])
  @@index([season])
  @@map("club_match_stats")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B4 — Data Quality & Integrity Engine (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Backend tools to keep the database clean as more leagues/clubs are imported.
// New tables only; ranking tables are read-only for validation. Merges are
// non-destructive (source is archived + aliased, history preserved).
// ═════════════════════════════════════════════════════════════════════════════

// A non-destructive merge of one duplicate into another. The source is archived
// (never deleted) and a snapshot is kept so the merge is reversible/auditable.
model MergeRecord {
  id          String    @id @default(uuid())
  entityType  String    // CLUB | LEAGUE
  sourceId    String
  sourceName  String
  targetId    String
  targetName  String
  reason      String?
  movedCounts String?   // JSON — what was repointed (seasons, matches, variants…)
  snapshot    String?   // JSON — the source record pre-merge (for reversal)
  performedBy String?
  reversedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([entityType])
  @@index([sourceId])
  @@index([targetId])
  @@map("merge_records")
}

// Persistent alias / abbreviation → canonical club. Populated by the identity
// resolver, by merges (old name → surviving club) and by admins.
model ClubAlias {
  id              String   @id @default(uuid())
  alias           String
  normalizedAlias String   @unique
  clubId          String
  source          String   @default("MANUAL") // MANUAL | MERGE | IMPORT | RESOLVER
  confidence      Float    @default(1)
  createdAt       DateTime @default(now())

  @@index([clubId])
  @@map("club_aliases")
}

// League eligibility validation result (1:1 with a league by leagueId). Flags a
// competition that may not belong in a country A-Grade national ranking.
model LeagueEligibility {
  id              String   @id @default(uuid())
  leagueId        String   @unique
  leagueName      String
  verdict         String   @default("ELIGIBLE") // ELIGIBLE | REVIEW | INELIGIBLE
  isMetro         Boolean  @default(false)
  isJunior        Boolean  @default(false)
  isSocial        Boolean  @default(false)
  isIndoor        Boolean  @default(false)
  isLowerDivision Boolean  @default(false)
  isNonTown       Boolean  @default(false)
  hasGenericTeams Boolean  @default(false)
  reasons         String?  // JSON string[]
  confidence      Float    @default(0.5)
  checkedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([verdict])
  @@map("league_eligibility")
}

// Stored data-health report snapshots (history of the database's cleanliness).
model DataHealthSnapshot {
  id          String   @id @default(uuid())
  counts      String   // JSON — headline counts
  report      String   // JSON — full detailed report
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("data_health_snapshots")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE B2 — Club & League Claiming Platform (ADDITIVE)
// ─────────────────────────────────────────────────────────────────────────────
// Backend infrastructure so verified clubs/leagues can manage their own presence
// in future phases. NONE of this is exposed in the UI yet. Every model is a NEW
// table. To keep existing tables (clubs/leagues/ranking) LITERALLY untouched,
// these models reference clubId/leagueId/userId as plain indexed columns with NO
// Prisma relation into existing models — so no back-relation field is added to
// any existing model, and no existing column/table is altered.
// ═════════════════════════════════════════════════════════════════════════════

// End-user accounts (distinct from internal AdminUser). Designed for 100k+ rows.
model PlatformUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  phone        String?
  passwordHash String?   // future auth; null until they set a password
  emailVerified Boolean  @default(false)
  lastLoginAt  DateTime?
  deletedAt    DateTime? // soft delete only
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
  @@map("platform_users")
}

// Club claim workflow. A Club is UNCLAIMED until a claim reaches VERIFIED.
// Claim record lifecycle: PENDING → VERIFIED | REJECTED.
model ClubClaim {
  id            String    @id @default(uuid())
  clubId        String
  clubName      String    // snapshot at submission
  applicantName String
  email         String
  phone         String?
  role          String    // President | Secretary | Coach | Committee | Other
  reason        String
  status        String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  submittedAt   DateTime  @default(now())
  reviewedBy    String?   // AdminUser id
  reviewNotes   String?
  approvedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clubId])
  @@index([status])
  @@index([email])
  @@map("club_claims")
}

// League claim workflow — mirrors ClubClaim.
model LeagueClaim {
  id            String    @id @default(uuid())
  leagueId      String
  leagueName    String
  applicantName String
  email         String
  phone         String?
  role          String
  reason        String
  status        String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  submittedAt   DateTime  @default(now())
  reviewedBy    String?
  reviewNotes   String?
  approvedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leagueId])
  @@index([status])
  @@index([email])
  @@map("league_claims")
}

// A user's membership of a club, with a role. Multiple users per club; a user
// may belong to many clubs. Unique(clubId,userId) prevents duplicate owners.
model ClubMembership {
  id        String    @id @default(uuid())
  clubId    String
  userId    String
  role      String    @default("VIEWER") // OWNER | ADMINISTRATOR | EDITOR | CONTRIBUTOR | VIEWER
  status    String    @default("ACTIVE") // ACTIVE | INVITED | REVOKED
  invitedBy String?   // PlatformUser id who invited them
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId])
  @@map("club_memberships")
}

// Extended, editable club profile (1:1 with a club by clubId). Holds all the
// self-managed content, verification, feature flags and billing fields so the
// existing "clubs" table is never modified.
model ClubProfile {
  id             String    @id @default(uuid())
  clubId         String    @unique

  // Location / contact
  ground         String?
  address        String?
  googleMapsUrl  String?
  websiteUrl     String?
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  youtubeUrl     String?
  email          String?
  phone          String?

  // Club details
  trainingNights String?
  homeCourt      String?
  clubColours    String?
  history        String?
  foundedYear    Int?

  // Committee (structured people)
  committee      String?   // JSON array of { name, role }
  president      String?
  secretary      String?
  coach          String?
  assistantCoach String?

  // Media references (JSON arrays of MediaAsset ids or urls)
  uniformPhotos  String?
  gallery        String?
  partnerLogos   String?

  // Links
  membershipLink String?
  volunteerLink  String?

  // Verification
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?   // AdminUser id
  verificationNotes String?

  // Feature flags
  premium       Boolean @default(false)
  featured      Boolean @default(false)
  hidden        Boolean @default(false)
  suspended     Boolean @default(false)
  archived      Boolean @default(false)
  imported      Boolean @default(false)
  playhqManaged Boolean @default(false)
  manualOverride Boolean @default(false)

  // Billing (preparation only — no Stripe yet)
  plan           String?   // free | starter | pro
  trialStatus    String?   // none | active | expired
  billingStatus  String?   // none | active | past_due | canceled
  renewalDate    DateTime?
  customerId     String?    // future Stripe customer id
  subscriptionId String?    // future Stripe subscription id

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("club_profiles")
}

// Extended, editable league profile (1:1 with a league by leagueId).
model LeagueProfile {
  id           String    @id @default(uuid())
  leagueId     String    @unique

  history          String?
  headOffice       String?
  websiteUrl       String?
  facebookUrl      String?
  instagramUrl     String?
  tiktokUrl        String?
  youtubeUrl       String?
  committee        String?   // JSON array
  president        String?
  secretary        String?
  operationsManager String?
  logoUrl          String?
  heroImageUrl     String?
  contactEmail     String?
  phone            String?
  region           String?

  // Verification
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  verificationNotes String?

  // Feature flags
  premium       Boolean @default(false)
  featured      Boolean @default(false)
  hidden        Boolean @default(false)
  suspended     Boolean @default(false)
  archived      Boolean @default(false)
  imported      Boolean @default(false)
  playhqManaged Boolean @default(false)
  manualOverride Boolean @default(false)

  // Billing
  plan           String?
  trialStatus    String?
  billingStatus  String?
  renewalDate    DateTime?
  customerId     String?
  subscriptionId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("league_profiles")
}

// Sponsor platform — attaches to a club, a league, or the whole platform.
model Sponsor {
  id           String    @id @default(uuid())
  scope        String    @default("CLUB") // CLUB | LEAGUE | PLATFORM
  clubId       String?
  leagueId     String?
  name         String
  websiteUrl   String?
  logoUrl      String?
  description  String?
  tier         String?   // platinum | gold | silver | bronze | partner
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clubId])
  @@index([leagueId])
  @@index([scope])
  @@map("sponsors")
}

// Media library — stores references (URLs) only. No uploader UI.
model MediaAsset {
  id           String    @id @default(uuid())
  scope        String    @default("CLUB") // CLUB | LEAGUE | PLATFORM
  clubId       String?
  leagueId     String?
  kind         String    // IMAGE | VIDEO | DOCUMENT | HERO | GALLERY | SPONSOR | PDF
  url          String
  title        String?
  mimeType     String?
  sizeBytes    Int?
  width        Int?
  height       Int?
  uploadedBy   String?   // PlatformUser id
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clubId])
  @@index([leagueId])
  @@index([kind])
  @@map("media_assets")
}

// Pending invitations for club administrators / editors / contributors.
model ClubInvitation {
  id        String    @id @default(uuid())
  clubId    String
  email     String
  role      String    @default("CONTRIBUTOR") // ADMINISTRATOR | EDITOR | CONTRIBUTOR
  token     String    @unique
  status    String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  invitedBy String?   // PlatformUser id
  expiresAt DateTime?
  acceptedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clubId])
  @@index([email])
  @@index([status])
  @@map("club_invitations")
}

// Notifications (backend only — no delivery yet).
model PlatformNotification {
  id         String    @id @default(uuid())
  userId     String?   // PlatformUser id; null = broadcast/admin
  type       String    // CLUB_CLAIMED | LEAGUE_CLAIMED | CLAIM_APPROVED | CLAIM_REJECTED | SPONSOR_EXPIRED | VERIFICATION_REQUIRED | ADMIN_INVITED
  title      String
  body       String?
  entityType String?
  entityId   String?
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([read])
  @@map("platform_notifications")
}

// Field-level change log for self-managed edits. Separate from the ranking
// AuditLog so the existing audit table is untouched. Designed for millions of
// rows. IP / user-agent kept for the future.
model ProfileChangeLog {
  id            String   @id @default(uuid())
  actorType     String   @default("USER") // USER | ADMIN | SYSTEM
  actorId       String?
  entityType    String   // Club | League | Sponsor | Media | Membership
  entityId      String
  field         String
  previousValue String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("profile_change_logs")
}
